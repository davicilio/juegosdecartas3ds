# Copia este archivo como .env (en esta misma carpeta) y rellena lo que uses.
# Las plataformas sin datos simplemente no se leen.

# --- Backloggd (obligatorio) -------------------------------------------------
# Valor de la cookie _backloggd_session (navegador → herramientas de desarrollo →
# Aplicación/Almacenamiento → Cookies → backloggd.com).
BACKLOGGD_COOKIE=
# Opcional: para volver a iniciar sesión solo cuando la cookie caduque.
BACKLOGGD_USUARIO=
BACKLOGGD_CONTRASENA=

# --- Steam ---------------------------------------------------------------------
# Clave: https://steamcommunity.com/dev/apikey · SteamID64 (17 cifras): https://steamid.io
# El perfil debe tener en público los «Detalles de los juegos».
STEAM_API_KEY=
STEAM_ID=

# --- Epic Games ----------------------------------------------------------------
# Mejor con «python3 sincronizar.py login-epic», que lo guarda en estado.json.
# Solo hace falta aquí para GitHub Actions (el primer valor; luego se renueva solo).
EPIC_REFRESH_TOKEN=

# --- PlayStation (PS5 y PS4) ---------------------------------------------------
# Inicia sesión en playstation.com y abre https://ca.account.sony.com/api/v1/ssocookie
PSN_NPSSO=

# --- Nintendo Switch / Switch 2 ------------------------------------------------
# Mejor con «python3 sincronizar.py login-nintendo». Requiere la consola vinculada a la
# app Control Parental de Nintendo Switch.
NINTENDO_SESSION_TOKEN=
# Apodo de tu usuario en la consola, si la comparte más gente (si no, se suma todo).
NINTENDO_JUGADOR=

# --- Opciones ------------------------------------------------------------------
ZONA_HORARIA=Europe/Madrid
# Un juego no se envía hasta sumar al menos estos minutos en el día.
MINUTOS_MINIMOS=5
# 1 = cuando marques un juego como Played/Completed/Retired en Backloggd, su última
# sesión se marca como el final de la partida.
MARCAR_TERMINADOS=1
